{
  "env": {
    "COT_GUARD_MIN_CHARS": "200",
    "COT_GUARD_MAX_BLOCKS": "2",
    "COT_GUARD_ALLOWLIST": "claude-opus-4-5,claude-opus-4-6,claude-opus-4-7,claude-opus-4-8,claude-sonnet-,claude-haiku-,claude-fable-5",
    "COT_GUARD_STATE_URL": "http://127.0.0.1:8800/cot-state/{session_id}"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/cot_guard_hook.py\"",
            "timeout": 6
          }
        ]
      }
    ]
  }
}
